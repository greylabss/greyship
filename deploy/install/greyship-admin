#!/bin/sh
# Looking after a Greyship server: greyship-admin status | logs [service] | password [email] | add-users <file> | backup | restore <file> | domain | upgrade | version
# The grey command (for deploying apps) is a different program; this one only runs on the server.
set -eu
services="api builder scheduler agent router dashboard"
compose="docker compose -p greyship -f /usr/local/lib/greyship/compose.yml"

case "${1:-status}" in
	status)
		for s in $services; do
			state=$(systemctl is-active "greyship-$s" 2>/dev/null || true)
			printf '%-12s %s\n' "$s" "$state"
		done
		printf '%-12s %s\n' infra "$(systemctl is-active greyship-infra 2>/dev/null || true)"
		;;
	logs)
		svc=${2:-api}
		exec journalctl -u "greyship-$svc" -n 100 -f --no-pager
		;;
	reset-password | password)
		# A forgotten password is fixed here, on the server: the account gets a new random password, printed once, and
		# is signed out everywhere. A saved password can't be shown (only its hash is stored), so this sets a new one.
		# Without an email it is the owner's: the address the installer was given.
		[ "$(id -u)" = 0 ] || { echo "run as root: sudo greyship-admin password [email]" >&2; exit 1; }
		email=${2:-}
		[ -n "$email" ] || email=$(sed -n 's/^GREYSHIP_OWNER_EMAIL=//p' /etc/greyship/greyship.env)
		[ -n "$email" ] || { echo "usage: greyship-admin password <email>" >&2; exit 1; }
		# systemd reads greyship.env exactly as the service does, and runs the command as the same user.
		exec systemd-run --quiet --wait --pipe --collect -p User=greyship -p EnvironmentFile=/etc/greyship/greyship.env \
			/usr/local/lib/greyship/greyship-api reset-password "$email"
		;;
	add-users)
		# Makes an account for every email in a file (one per line), all with the same password, which you give when
		# asked (or in GREYSHIP_USERS_PASSWORD). Tell people to change it in Settings. Emails that already have an
		# account are left alone.
		[ "$(id -u)" = 0 ] || { echo "run as root: sudo greyship-admin add-users <file of emails>" >&2; exit 1; }
		file=${2:-}
		[ -f "$file" ] || { echo "usage: greyship-admin add-users <file with one email per line>" >&2; exit 1; }
		password=${GREYSHIP_USERS_PASSWORD:-}
		if [ -z "$password" ]; then
			printf "Password for all of them (10 to 128 characters): " >&2
			stty -echo 2>/dev/null || true
			read -r password
			stty echo 2>/dev/null || true
			echo >&2
		fi
		{ printf '%s\n' "$password"; cat "$file"; } | exec systemd-run --quiet --wait --pipe --collect -p User=greyship -p EnvironmentFile=/etc/greyship/greyship.env \
			/usr/local/lib/greyship/greyship-api create-users
		;;
	backup)
		# One file with the database and /etc/greyship (the master key, certificates' settings, the GitHub app key).
		# It does not hold the built binaries and uploaded sources in storage: those are only needed to roll back, and
		# any project can be deployed again from its source. Keeps the newest 5 in the folder. The installer takes one
		# before every upgrade.
		[ "$(id -u)" = 0 ] || { echo "run as root: sudo greyship-admin backup [folder]" >&2; exit 1; }
		quiet=0
		dir=/var/backups/greyship
		shift
		for a in "$@"; do
			case "$a" in --quiet) quiet=1 ;; *) dir=$a ;; esac
		done
		version=$(cat /usr/local/lib/greyship/VERSION 2>/dev/null || echo unknown)
		work=$(mktemp -d)
		trap 'rm -rf "$work"' EXIT
		umask 077
		mkdir -p "$dir" "$work/etc"
		$compose exec -T postgres pg_dump -U greyship -Fc greyship >"$work/db.dump" || { echo "couldn't dump the database: is Greyship running? (greyship-admin status)" >&2; exit 1; }
		cp -a /etc/greyship/. "$work/etc/"
		printf '%s\n' "$version" >"$work/VERSION"
		out="$dir/greyship-$version-$(date +%Y%m%d-%H%M%S).tar.gz"
		tar -czf "$out" -C "$work" db.dump etc VERSION
		ls -1t "$dir"/greyship-*.tar.gz 2>/dev/null | tail -n +6 | while read -r old; do rm -f "$old"; done
		[ "$quiet" = 1 ] || cat <<MSG
✓ Backup written: $out
It contains your secrets (the master key among them): keep it private, and copy it off this server.
To use it on a fresh server: install Greyship there, then   greyship-admin restore <file>
MSG
		;;
	restore)
		# Puts a backup's accounts, projects, deployments and env vars on a freshly installed Greyship (the same version
		# or newer than the backup's). The fresh server keeps its own storage and database settings.
		[ "$(id -u)" = 0 ] || { echo "run as root: sudo greyship-admin restore <backup file>" >&2; exit 1; }
		file=${2:-}
		[ -f "$file" ] || { echo "usage: greyship-admin restore <backup file>  (made by greyship-admin backup)" >&2; exit 1; }
		work=$(mktemp -d)
		trap 'rm -rf "$work"' EXIT
		umask 077
		tar -xzf "$file" -C "$work" || { echo "that isn't a Greyship backup" >&2; exit 1; }
		[ -f "$work/db.dump" ] && [ -f "$work/etc/greyship.env" ] || { echo "that isn't a Greyship backup" >&2; exit 1; }
		have=$(cat /usr/local/lib/greyship/VERSION 2>/dev/null || echo unknown)
		was=$(cat "$work/VERSION" 2>/dev/null || echo unknown)
		if [ "$have" != unknown ] && [ "$was" != unknown ] && [ "$(printf '%s\n%s\n' "$was" "$have" | sort -V | tail -1)" != "$have" ]; then
			echo "this backup is from $was, newer than the $have installed here. Install $was or newer first (greyship-admin upgrade)." >&2
			exit 1
		fi
		echo "This replaces everything in this Greyship (accounts, projects, deployments, env vars) with the backup from $was."
		if [ "${3:-}" != "--yes" ]; then
			printf "Type yes to continue: "
			read -r answer
			[ "$answer" = yes ] || { echo "cancelled"; exit 1; }
		fi
		env=/etc/greyship/greyship.env
		for s in $services; do systemctl stop "greyship-$s"; done
		$compose exec -T postgres pg_restore -U greyship -d greyship --clean --if-exists --no-owner <"$work/db.dump" || echo "(pg_restore reported warnings above; usually harmless)"
		# Secrets that the database's contents depend on come from the backup; infrastructure settings (database,
		# storage keys, node) stay as this server's installer wrote them.
		for key in GREYSHIP_MASTER_KEY GREYSHIP_COOKIE_SECRET GREYSHIP_PROXY_SECRET GREYSHIP_VAPID_PRIVATE_KEY GREYSHIP_OWNER_EMAIL GREYSHIP_RESEND_API_KEY GREYSHIP_MAIL_FROM GREYSHIP_NOTIFY_FROM; do
			val=$(sed -n "s|^$key=||p" "$work/etc/greyship.env" | head -1)
			[ -n "$val" ] || continue
			if grep -q "^$key=" "$env"; then sed -i "s|^$key=.*|$key=$(printf '%s' "$val" | sed 's/[&|]/\\&/g')|" "$env"; else echo "$key=$val" >>"$env"; fi
		done
		systemd-run --quiet --wait --pipe --collect -p User=greyship -p EnvironmentFile="$env" /usr/local/lib/greyship/greyship-migrate
		for s in $services; do systemctl start "greyship-$s"; done
		cat <<MSG
✓ Restored. Sign in with the accounts from the backup.
Not in a backup: built binaries and uploaded sources (redeploy a project to run it again; rollbacks to old deployments
won't work), and the domain settings (run greyship-admin domain again if this server uses a domain).
MSG
		;;
	domain)
		# Switches a server that's running on its IP (plain HTTP) to your own domains with HTTPS, or moves it to others.
		[ "$(id -u)" = 0 ] || { echo "run as root: sudo greyship-admin domain ..." >&2; exit 1; }
		dash=${2:-}
		apps=${3:-}
		email=${4:-}
		[ -n "$dash" ] && [ -n "$apps" ] || {
			cat >&2 <<USAGE
usage: greyship-admin domain <dashboard-domain> <apps-domain> [email]
  e.g. greyship-admin domain greyship.example.com example.net you@example.com
The dashboard domain needs an A record (and *.<dashboard-domain> for storage and the API); the apps domain needs a
wildcard record (*.<apps-domain>), all pointing at this server. A different registrable domain for apps is better.
USAGE
			exit 1
		}
		case "$dash$apps" in *[!A-Za-z0-9.-]*) echo "domains may only contain letters, digits, dots and dashes" >&2; exit 1 ;; esac
		[ "$dash" != "$apps" ] || { echo "the dashboard and the apps need different domains" >&2; exit 1; }
		env=/etc/greyship/greyship.env
		[ -n "$email" ] || email=$(sed -n 's/^GREYSHIP_OWNER_EMAIL=//p' "$env")
		[ -n "$email" ] || { echo "give an email as the third argument: Let's Encrypt needs a contact address" >&2; exit 1; }
		set_var() {
			if grep -q "^$1=" "$env"; then sed -i "s|^$1=.*|$1=$2|" "$env"; else echo "$1=$2" >> "$env"; fi
		}
		set_var GREYSHIP_PLATFORM_DOMAIN "$dash"
		set_var GREYSHIP_APPS_DOMAIN "$apps"
		set_var GREYSHIP_DASHBOARD_URL "https://$dash"
		set_var GREYSHIP_S3_ENDPOINT "https://s3.$dash"
		set_var GREYSHIP_ACME_EMAIL "$email"
		sed -i '/^GREYSHIP_HTTP_ONLY=/d; /^GREYSHIP_ROUTER_DEV_CA=/d' "$env"
		# The dashboard moves behind the router on the domain: loopback only, and its public port closes.
		old_port=$(sed -n 's/^PORT=//p' /etc/greyship/dashboard.env)
		sed -i 's/^PORT=.*/PORT=3000/; s/^HOSTNAME=.*/HOSTNAME=127.0.0.1/' /etc/greyship/dashboard.env
		sed -i 's|^GREYSHIP_ROUTER_PLATFORM=@=127.0.0.1:[0-9]*|GREYSHIP_ROUTER_PLATFORM=@=127.0.0.1:3000|' "$env"
		if [ -n "$old_port" ] && [ "$old_port" != 3000 ] && command -v ufw >/dev/null; then ufw delete allow "$old_port/tcp" >/dev/null 2>&1 || true; fi
		for s in api builder scheduler agent router dashboard; do systemctl restart "greyship-$s"; done
		ip=$(curl -4fsS --max-time 8 https://api.ipify.org 2>/dev/null || echo "this server's IP")
		cat <<MSG
✓ Now on HTTPS. Point these records at $ip:
    A   $dash       →  $ip
    A   *.$dash     →  $ip    (s3.… for uploads, api.… for the API)
    A   *.$apps     →  $ip    (your apps)
Certificates are issued the first time each name is visited, once DNS answers. Then open https://$dash and sign in
again (sessions don't carry over). On your computer: grey server https://$dash, then grey login
Apps you already deployed keep their names under the new apps domain.
MSG
		;;
	upgrade)
		exec sh -c 'curl -fsSL https://raw.githubusercontent.com/greylabss/greyship/main/deploy/install/install.sh | sh'
		;;
	version)
		cat /usr/local/lib/greyship/VERSION 2>/dev/null || echo unknown
		;;
	*)
		echo "usage: greyship-admin status | logs [service] | password [email] | add-users <file> | backup | restore <file> | domain | upgrade | version" >&2
		exit 1
		;;
esac
