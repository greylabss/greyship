# greyship-api settings for local development. Copy to .env and run `make dev`.
# Load it with make (not `source`): values like MAIL_FROM contain < > which a shell would misread.

# --- API server ---------------------------------------------------------------
GREYSHIP_ENV=development
GREYSHIP_API_ADDR=:8080
GREYSHIP_DATABASE_URL=postgres://greyship:greyship@localhost:5434/greyship?sslmode=disable
# Where the API is reachable (OAuth callbacks) and where the dashboard runs (CORS, redirects, device page).
GREYSHIP_PUBLIC_URL=http://localhost:8080
GREYSHIP_DASHBOARD_URL=http://localhost:3000

# Signs short-lived OAuth state cookies. Required. Generate with: openssl rand -hex 32
GREYSHIP_COOKIE_SECRET=

# --- Object storage (decisions.md 029) ------------------------------------------
# Empty in development: defaults match the Garage container and the key deploy/garage-init.sh imports.
# Required in production. The CLI uploads to presigned URLs on this endpoint, so it must be publicly reachable.
GREYSHIP_S3_ENDPOINT=
GREYSHIP_S3_REGION=
GREYSHIP_S3_BUCKET=
GREYSHIP_S3_ACCESS_KEY=
GREYSHIP_S3_SECRET_KEY=

# --- Login emails (decisions.md 023) --------------------------------------------
# Empty in development: codes are written to GREYSHIP_OUTBOX_DIR instead of being sent.
# Required in production; the sender domain must be verified in Resend.
GREYSHIP_RESEND_API_KEY=
GREYSHIP_MAIL_FROM=Greyship <login@greyship.tech>
GREYSHIP_OUTBOX_DIR=tmp/outbox

# --- OAuth apps (optional; a provider is enabled when both values are set) -------
# Callback URLs to register:
#   {GREYSHIP_PUBLIC_URL}/v1/auth/oauth/google/callback
#   {GREYSHIP_PUBLIC_URL}/v1/auth/oauth/github/callback
GREYSHIP_GOOGLE_CLIENT_ID=
GREYSHIP_GOOGLE_CLIENT_SECRET=
GREYSHIP_GITHUB_CLIENT_ID=
GREYSHIP_GITHUB_CLIENT_SECRET=

# --- grey CLI (read by the `grey` binary, not the API) --------------------------
# Point the CLI at your local API instead of https://api.greyship.tech:
#   GREYSHIP_API_URL=http://localhost:8080
# In CI, use a token from the dashboard instead of `grey login`:
#   GREYSHIP_TOKEN=gs_...
